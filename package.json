{
  "name": "diy-harness",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@diy-harness/config": "workspace:*",
    "turbo": "2.10.13",
    "typescript": "7.0.2"
  }
}
